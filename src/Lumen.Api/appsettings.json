{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentStorage": {
    "RootPath": "App_Data/Documents"
  },
  "Chunking": {
    "MaxTokensPerChunk": 250,
    "OverlapTokens": 60
  },
  "Jwt": {
    "Issuer": "Lumen",
    "Audience": "Lumen",
    "ExpiryMinutes": 60
  }
}
