{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentStorage": {
    "RootPath": "App_Data/Documents"
  },
  "Chunking": {
    "MaxTokensPerChunk": 250,
    "OverlapTokens": 60,
    "ContextHeaders": true,
    "MergeBelowTokens": 0,
    "ProtectDecimals": true
  },
  "Embeddings": {
    "Provider": "Fake",
    "Model": "text-embedding-3-small",
    "Endpoint": "",
    "Deployment": "",
    "ApiKey": "",
    "MaxBatchSize": 512
  },
  "Chat": {
    "Provider": "Fake",
    "Endpoint": "",
    "Deployment": "",
    "ApiKey": "",
    "Temperature": 0.2,
    "TopP": null,
    "ReasoningEffort": null,
    "MaxOutputTokens": 1024,
    "ContextTopK": 10
  },
  "Search": {
    "Mode": "Vector",
    "RrfK": 60,
    "Candidates": 50,
    "LexicalWeight": 1.0,
    "VectorWeight": 1.0,
    "MaxChunksPerDocument": null
  },
  "Mcp": {
    "ContextTool": false,
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "Lumen",
    "Audience": "Lumen",
    "ExpiryMinutes": 60
  }
}
