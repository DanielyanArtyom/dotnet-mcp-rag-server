{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentStorage": {
    "RootPath": "App_Data/Documents"
  },
  "Chunking": {
    "MaxTokensPerChunk": 250,
    "OverlapTokens": 60
  },
  "Embeddings": {
    "Provider": "Fake",
    "Model": "text-embedding-3-small",
    "Endpoint": "",
    "Deployment": "",
    "ApiKey": "",
    "MaxBatchSize": 512
  },
  "Chat": {
    "Provider": "Fake",
    "Endpoint": "",
    "Deployment": "",
    "ApiKey": "",
    "Temperature": null,
    "TopP": null,
    "ReasoningEffort": null,
    "MaxOutputTokens": 1024,
    "ContextTopK": 5
  },
  "Jwt": {
    "Issuer": "Lumen",
    "Audience": "Lumen",
    "ExpiryMinutes": 60
  }
}
